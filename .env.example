# Copy to .env and fill in what you use. Credentials live ONLY here — they are
# never stored in scenario configs, the database, or experiment traces.
# With nothing configured, the testbed still runs end-to-end on the built-in
# deterministic stub provider (no network, no cost).

# OpenRouter (https://openrouter.ai) — the main path: one key gives access to
# models from many vendors, so different agents in one experiment can run on
# different models. Each agent picks its model in the scenario config.
OPENROUTER_API_KEY=
# Optional attribution headers shown in your OpenRouter dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Azure OpenAI (optional alternative). An agent's "model" is then the
# deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Overrides the default ./data directory (SQLite database).
DATA_DIR=

# Local port for the web UI (default 3939). A PaaS-injected PORT wins if set.
GUI_PORT=

# Loopback (127.0.0.1) by default. There is NO authentication — only set
# 0.0.0.0 if you really want the testbed reachable from other machines.
GUI_HOST=
