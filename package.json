{
  "name": "agent-testbed",
  "version": "0.1.0",
  "description": "A small, configurable testbed for multi-agent LLM coordination experiments: shared room, routing, consensus, deterministic evaluation, full event trace.",
  "license": "Apache-2.0",
  "keywords": ["ai-agents", "multi-agent", "llm", "coordination", "experiments", "openrouter"],
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "start": "npm run setup && npm run gui",
    "build": "tsc -p tsconfig.json",
    "gui": "tsx src/server/main.ts",
    "experiment": "tsx src/cli/run.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "openai": "^6.45.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
