# Copy to .env and fill in what you use. Credentials live ONLY here — they are
# never stored in scenario configs, the database, or experiment traces.
# With nothing configured, the testbed still runs end-to-end on the built-in
# deterministic stub provider (no network, no cost).

# OpenRouter (https://openrouter.ai) — the main path: one key gives access to
# models from many vendors, so different agents in one experiment can run on
# different models. Each agent picks its model in the scenario config.
OPENROUTER_API_KEY=
# Optional attribution headers shown in your OpenRouter dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Azure OpenAI (optional alternative). An agent's "model" is then the
# deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Overrides the default ./data directory (SQLite database).
DATA_DIR=

# Local port for the web UI (default 3939). A PaaS-injected PORT wins if set.
GUI_PORT=

# Loopback (127.0.0.1) by default. Without OPERATOR_TOKEN there is NO
# authentication — only set 0.0.0.0 if you really want the testbed reachable
# from other machines, and then set OPERATOR_TOKEN.
GUI_HOST=
# When set, the UI and the operator API require it: HTTP Basic auth with any
# user name and this as the password (or "Authorization: Bearer <token>").
# Required on any public host. Use a long random value.
OPERATOR_TOKEN=
# Host names the UI answers to besides localhost/127.0.0.1 (DNS-rebinding guard:
# any other Host header gets 421). Only needed when you reach it under another
# name, e.g. with GUI_HOST=0.0.0.0. Comma-separated.
GUI_ALLOWED_HOSTS=

# Per-call latency (ms) of the built-in stub provider in the web UI, so stub
# runs can be watched live (default 300). CLI and batch runs ignore it.
STUB_LATENCY_MS=

# Maximum simultaneous in-flight requests per real LLM provider (OpenRouter,
# Azure), shared by every experiment and batch in the process (default 8).
# Independent of batch concurrency: a single experiment's voting step alone
# issues one request per agent. The stub provider is never limited.
LLM_MAX_CONCURRENT_REQUESTS=
# The post-run debrief's own request slots per real provider (default 2) —
# separate from the experiments' slots, so people asking questions never delay a
# running experiment. Adds to the provider's total concurrency.
LLM_MAX_CONCURRENT_DEBRIEF_REQUESTS=

# External Room API (docs/external-room-api.md): a separate listener serving
# only /api/external/* for an external room adapter (e.g. a chat product).
# Disabled unless a token is set; use a long random value. The token is not
# encryption — put TLS (reverse proxy) or a private network in front of it.
EXTERNAL_API_TOKEN=
# Default 3940 / 127.0.0.1.
EXTERNAL_API_PORT=
EXTERNAL_API_HOST=
# "separate" (default) or "main": serve /api/external/* on the UI's listener
# instead (platforms with one public port per service, e.g. Railway). Its own
# bearer token applies either way.
EXTERNAL_API_LISTENER=
# Default-deny: comma-separated scenarios that may be started externally —
# built-in ids (station-kestrel runs free stub agents) or library scenario ids.
EXTERNAL_SCENARIOS=

# SQLite durability for the trace database: NORMAL (default), FULL, EXTRA or
# OFF. NORMAL in WAL mode survives process crashes and restarts; only an OS
# crash / power loss can drop the latest commits. FULL fsyncs every trace
# event (much slower). The effective value is recorded on every run.
SQLITE_SYNCHRONOUS=
